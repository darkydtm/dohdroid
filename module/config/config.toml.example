listen_address = "127.0.0.1"
listen_port = 5353
# Connection-establishment timeout in milliseconds; typical range: 500-10000 ms.
connect_timeout_ms = 3000
# End-to-end DNS request timeout in milliseconds; typical range: 1000-30000 ms.
request_timeout_ms = 5000
cache_enabled = true
# Maximum cached DNS entries (count); typical range: 256-65536 entries.
cache_capacity = 4096
fallback_mode = "system"
# Empty uses the configured system resolver source; there is no additional resolver fallback list.
resolvers = []
